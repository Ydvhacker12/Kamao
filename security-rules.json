{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('users').child(auth.uid).child('isAdmin').val() == true)",
        ".write": "auth != null && auth.uid == $uid",
        
        "displayName": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 50"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().matches(/^[^@]+@[^@]+\\.[^@]+$/)"
        },
        "photoURL": {
          ".validate": "newData.isString() && (newData.val() == '' || newData.val().matches(/^data:image\\//) || newData.val().matches(/^https:\\/\\//))"
        },
        "balance": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "winningCash": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "bonusCash": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "totalEarnings": {
          ".read": true,
          ".write": "root.child('users').child(auth.uid).child('isAdmin').val() == true"
        },
        "isAdmin": {
          ".read": true,
          ".write": "root.child('users').child(auth.uid).child('isAdmin').val() == true"
        },
        "referralCode": {
          ".validate": "newData.isString() && newData.val().length >= 6 && newData.val().length <= 20"
        },
        "referredBy": {
          ".validate": "newData.isString() || newData.val() == null"
        },
        "createdAt": {
          ".validate": "newData.isNumber() || newData.isString()"
        },
        
        "meta": {
          ".read": "auth != null && (auth.uid == $uid || root.child('users').child(auth.uid).child('isAdmin').val() == true)",
          ".write": "auth != null && auth.uid == $uid",
          
          "device": {
            ".validate": "newData.hasChildren(['userAgent', 'deviceType', 'browser', 'screenWidth', 'screenHeight', 'timestamp'])"
          },
          "location": {
            ".validate": "newData.hasChildren(['ip', 'city', 'region', 'country', 'timestamp'])"
          }
        },
        
        "fcmToken": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "newData.hasChildren(['token', 'updatedAt', 'platform'])"
        }
      }
    },
    
    "adminConfig": {
      ".read": "auth != null",
      ".write": "auth != null && (!data.exists() || root.child('users').child(auth.uid).child('isAdmin').val() == true)"
    },
    
    "tournamentPricing": {
      ".read": true,
      ".write": "root.child('users').child(auth.uid).child('isAdmin').val() == true",
      
      "tiers": {
        "$tierId": {
          ".validate": "newData.hasChildren(['name', 'price', 'tournamentLimit', 'description', 'status'])"
        }
      },
      "settings": {
        ".validate": "newData.hasChildren(['enabled', 'defaultTier'])"
      }
    },
    
    "tournaments": {
      "$tournamentId": {
        ".read": true,
        ".write": "auth != null && (root.child('users').child(auth.uid).child('isAdmin').val() == true || (newData.child('status').val() == 'upcoming' && newData.child('creatorId').val() == auth.uid))",
        
        ".validate": "newData.hasChildren(['name', 'gameName', 'status', 'entryFee', 'startTime', 'creatorId'])",
        
        "registeredPlayers": {
          "$playerId": {
            ".write": "auth != null && auth.uid == $playerId",
            ".validate": "newData.val() == true || newData.val() == false"
          }
        },
        
        "results": {
          "$playerId": {
            ".write": "root.child('users').child(auth.uid).child('isAdmin').val() == true",
            ".validate": "newData.hasChildren(['rank', 'prize', 'kills'])"
          }
        }
      }
    },
    
    "payments": {
      "$paymentId": {
        ".read": "auth != null && (root.child('payments').child($paymentId).child('userId').val() == auth.uid || root.child('users').child(auth.uid).child('isAdmin').val() == true)",
        ".write": "auth != null && (root.child('payments').child($paymentId).child('userId').val() == auth.uid || root.child('users').child(auth.uid).child('isAdmin').val() == true)",
        
        ".validate": "newData.hasChildren(['userId', 'amount', 'status', 'timestamp', 'paymentMethod'])"
      }
    },
    
    "withdrawals": {
      "$withdrawalId": {
        ".read": "auth != null && (root.child('withdrawals').child($withdrawalId).child('userId').val() == auth.uid || root.child('users').child(auth.uid).child('isAdmin').val() == true)",
        ".write": "auth != null && (root.child('withdrawals').child($withdrawalId).child('userId').val() == auth.uid || root.child('users').child(auth.uid).child('isAdmin').val() == true)",
        
        ".validate": "newData.hasChildren(['userId', 'amount', 'status', 'timestamp', 'withdrawalMethod'])"
      }
    },
    
    "referrals": {
      "$referralId": {
        ".read": "auth != null",
        ".write": "auth != null",
        
        ".validate": "newData.hasChildren(['new_user_id', 'referrer_user_id', 'bonus_amount_new_user', 'bonus_amount_referrer', 'date'])"
      }
    },
    
    "referralCodeToUid": {
      "$referralCode": {
        ".read": "auth != null",
        ".write": "auth != null",
        
        ".validate": "newData.hasChildren(['uid'])"
      }
    },
    
    "phoneToUid": {
      "$phone": {
        ".read": "auth != null",
        ".write": "auth != null",
        
        ".validate": "newData.hasChildren(['uid'])"
      }
    },
    
    "notifications": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && (auth.uid == $uid || root.child('users').child(auth.uid).child('isAdmin').val() == true)",
        
        "$notificationId": {
          ".validate": "newData.hasChildren(['title', 'message', 'timestamp', 'read', 'type'])"
        }
      }
    },
    
    "settings": {
      ".read": true,
      ".write": "root.child('users').child(auth.uid).child('isAdmin').val() == true",
      
      ".validate": "newData.hasChildren(['appName', 'minWithdraw', 'referralBonus', 'referrerBonus', 'logoUrl'])"
    },
    
    "ads_code": {
      ".read": true,
      ".write": "root.child('users').child(auth.uid).child('isAdmin').val() == true",
      
      ".validate": "newData.hasChildren(['htmlCode', 'updatedAt'])"
    },
    
    "games": {
      "$gameId": {
        ".read": true,
        ".write": "root.child('users').child(auth.uid).child('isAdmin').val() == true",
        
        ".validate": "newData.hasChildren(['name', 'category', 'status', 'imageUrl'])"
      }
    },
    
    "promotions": {
      "$promotionId": {
        ".read": true,
        ".write": "root.child('users').child(auth.uid).child('isAdmin').val() == true",
        
        ".validate": "newData.hasChildren(['title', 'description', 'imageUrl', 'status', 'startDate', 'endDate'])"
      }
    },
    
    "help_center": {
      "$sessionId": {
        ".read": "auth != null && (root.child('help_center').child($sessionId).child('userId').val() == auth.uid || root.child('users').child(auth.uid).child('isAdmin').val() == true)",
        ".write": "auth != null && (root.child('help_center').child($sessionId).child('userId').val() == auth.uid || root.child('users').child(auth.uid).child('isAdmin').val() == true)",
        
        ".validate": "newData.hasChildren(['userId', 'message', 'timestamp', 'status', 'adminReply'])"
      }
    },
    
    "app_updates": {
      "$updateId": {
        ".read": "auth != null",
        ".write": "root.child('users').child(auth.uid).child('isAdmin').val() == true",
        
        ".validate": "newData.hasChildren(['version', 'title', 'description', 'timestamp', 'forceUpdate'])"
      }
    }
  }
}
